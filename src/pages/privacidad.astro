---
// BORRADOR pendiente de revision legal. Mientras PUBLIC_ANALYTICS_ENABLED no sea
// "true" la pagina responde 404 (no se mide ni se publica nada hasta que se apruebe).
export const prerender = false;

import Layout from "../layouts/Layout.astro";

if (import.meta.env.PUBLIC_ANALYTICS_ENABLED !== "true") {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Los datos entre [corchetes] son pendientes que debe completar o confirmar el revisor.
const sections = [
  {
    title: "1. Quién es el responsable",
    body: [
      "Roca Business [COMPLETAR: razón social, cédula jurídica y domicilio] es el responsable del tratamiento de los datos personales descritos en esta política, conforme a la Ley N.° 8968, Protección de la Persona frente al Tratamiento de sus Datos Personales, y su reglamento.",
      "Contacto para cualquier consulta sobre tus datos: asesorias@rocabusiness.net · +506 7044-2878.",
    ],
  },
  {
    title: "2. Qué medimos cuando visitás el sitio",
    body: ["Medimos las visitas de forma anónima, solo para saber qué propiedades y servicios interesan y desde dónde llegan las personas. Por cada visita guardamos únicamente:"],
    list: [
      "La página que viste y, si es una propiedad, cuál.",
      "El origen de la visita (por ejemplo Facebook, Instagram, Google, WhatsApp o directo) y, si el enlace lo traía, la publicación que lo originó.",
      "El tipo de dispositivo (celular, computadora o tableta) y el idioma del sitio.",
      "La provincia y el país aproximados, deducidos en el momento a partir de tu conexión.",
      "Si tocaste el botón de WhatsApp o enviaste el formulario de contacto, y desde qué propiedad.",
    ],
    after: [
      "No guardamos tu dirección IP, no usamos cookies de seguimiento, no te seguimos de un día a otro ni entre sitios, y no compartimos estos datos con publicidad. Solo usamos un código al azar que vive en tu navegador mientras la pestaña está abierta y se borra al cerrarla.",
      "Respetamos la señal «No rastrear» (Do Not Track) y el Control Global de Privacidad de tu navegador: si están activados, no medimos tu visita.",
    ],
  },
  {
    title: "3. Los datos que nos das en el formulario",
    body: ["Si completás el formulario de contacto, guardamos los datos que escribís (nombre, correo, teléfono, mensaje y el servicio o la propiedad por la que consultás) para responder tu solicitud. Un asesor de Roca Business te contactará usando esos datos."],
  },
  {
    title: "4. Con quién compartimos los datos",
    body: ["No vendemos ni cedemos tus datos. Usamos proveedores que los procesan por encargo nuestro, algunos fuera de Costa Rica [REVISAR: transferencia internacional y consentimiento]:"],
    list: [
      "Supabase: base de datos donde se guardan las consultas y las visitas anónimas.",
      "Vercel: alojamiento del sitio web.",
      "Resend: envío de los correos de confirmación y de aviso al equipo.",
      "Cloudinary: alojamiento de fotos y videos del sitio.",
    ],
    after: ["Si tocás el botón de WhatsApp o los enlaces a redes sociales, salís de nuestro sitio y rige la política de privacidad de esa plataforma."],
  },
  {
    title: "5. Por cuánto tiempo los guardamos",
    body: [],
    list: [
      "Visitas anónimas: el detalle se conserva 90 días y luego solo se guardan resúmenes agrupados sin datos individuales [REVISAR: plazo].",
      "Consultas del formulario: el tiempo necesario para atender tu solicitud y el seguimiento comercial relacionado [COMPLETAR: plazo].",
    ],
  },
  {
    title: "6. Tus derechos",
    body: [
      "Podés pedir en cualquier momento acceso a tus datos, que los rectifiquemos o los eliminemos, y retirar tu consentimiento, escribiendo a asesorias@rocabusiness.net. Te responderemos en los plazos que fija la ley [REVISAR: plazo].",
      "Si considerás que tus derechos no fueron atendidos, podés acudir a la Agencia de Protección de Datos de los Habitantes (PRODHAB).",
    ],
  },
  {
    title: "7. Cambios a esta política",
    body: ["Si cambiamos la forma de medir o de tratar tus datos, actualizaremos esta página. Última actualización: [COMPLETAR: fecha de aprobación]."],
  },
];
---

<Layout
  title="Política de privacidad | Roca Business"
  description="Cómo Roca Business mide las visitas de forma anónima y cómo trata los datos que recibe por el formulario de contacto."
>
  <main class="bg-white">
    <section
      id="hero"
      class="relative isolate overflow-hidden bg-gradient-to-br from-deepest via-primary to-dark pb-16 pt-32 sm:pt-36 lg:pt-40"
    >
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h1 class="font-heading text-4xl font-bold text-light sm:text-5xl">
            Política de privacidad
          </h1>
          <div class="mx-auto mt-6 h-1 w-20 rounded-full bg-dark"></div>
          <p class="mt-6 font-heading text-lg text-light">
            Medimos las visitas sin cookies de seguimiento y sin guardar tu dirección IP.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
      {
        sections.map((s) => (
          <article class="mb-10">
            <h2 class="font-heading text-2xl font-bold text-deepest">{s.title}</h2>
            {s.body.map((p) => (
              <p class="mt-3 font-heading text-base leading-relaxed text-deepest/80">{p}</p>
            ))}
            {s.list && (
              <ul class="mt-3 list-disc space-y-2 pl-6 font-heading text-base leading-relaxed text-deepest/80">
                {s.list.map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
            )}
            {s.after?.map((p) => (
              <p class="mt-3 font-heading text-base leading-relaxed text-deepest/80">{p}</p>
            ))}
          </article>
        ))
      }
    </section>
  </main>
</Layout>
